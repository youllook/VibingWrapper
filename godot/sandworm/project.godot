config_version=5

[application]

config/name="Sandworm"
config/description="沙蟲 — through a natural rock arch, a colossal sandworm bursts out of the dunes at sunset (VibingWrapper theme)"
run/main_scene="res://main.tscn"
; 0 on purpose: on the web a max_fps cap busy-waits inside the frame; the HTML shell throttles rAF to 30 fps instead
run/max_fps=0
boot_splash/show_image=false
boot_splash/bg_color=Color(0.12, 0.07, 0.04, 1)

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_s3tc_bptc=true
